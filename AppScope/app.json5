// 版本号规则（CI 构建时按日期动态生成，见 .github/workflows/build-hap.yml Set dynamic version）：
//   versionName = 1.MMDD.NN （MMDD=构建月份日期，NN=当日构建序号，同日依次 .01/.02/.03，跨日重置 .01）
//   versionCode = MMDDNN 前补一位 1 后整体视作十进制（1.1002.01 -> 1100201，同日随 NN 递增，跨日随 MMDD 递增）
// 出包文件名统一按包名：lagado.hm.app_<versionName>.hap
{
  "app": {
    "bundleName": "lagado.hm.app",
    "vendor": "legado",
    "versionCode": 1100801,
    "versionName": "1.1008.01",
    "bundleType": "app",
    "debug": false,
    "icon": "$media:layered_image",
    "label": "$string:app_name",
    "buildVersion": "1100408",
    "distributedNotificationEnabled": true,
    "keepAlive": false,
    "minAPIVersion": 12,
    "targetAPIVersion": 26,
    "alternateIcons": [
      {
        "name": "ic_app_warm_book",
        "icon": "$media:ic_app_warm_book"
      },
      {
        "name": "ic_app_night_neon",
        "icon": "$media:ic_app_night_neon"
      },
      {
        "name": "ic_app_minimal_line",
        "icon": "$media:ic_app_minimal_line"
      },
      {
        "name": "ic_app_ink_wash",
        "icon": "$media:ic_app_ink_wash"
      },
      {
        "name": "ic_app_pixel_retro",
        "icon": "$media:ic_app_pixel_retro"
      },
      {
        "name": "ic_app_theme_classic_blue",
        "icon": "$media:ic_app_theme_classic_blue"
      },
      {
        "name": "ic_app_theme_warm_paper",
        "icon": "$media:ic_app_theme_warm_paper"
      },
      {
        "name": "ic_app_theme_forest_mist",
        "icon": "$media:ic_app_theme_forest_mist"
      },
      {
        "name": "ic_app_theme_ink_wash",
        "icon": "$media:ic_app_theme_ink_wash"
      },
      {
        "name": "ic_app_theme_neon_night",
        "icon": "$media:ic_app_theme_neon_night"
      }
    ]
  }
}
